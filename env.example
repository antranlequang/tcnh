# Supabase Configuration
# Get these values from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Admin-only secret key (server-side; never expose with NEXT_PUBLIC_).
# Required for admin writes, uploads, registration forms, and forum approvals.
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Password used to protect /admin form/template endpoints.
# (Current default fallback is "maiyeuquangan")
ADMIN_PASSWORD=maiyeuquangan

# Secret used by scheduled keep-alive requests to /api/cron/supabase-keepalive.
# Set the same value in your deployment environment.
CRON_SECRET=replace_with_a_long_random_secret


NEXT_PUBLIC_SANITY_DATASET=xxx
NEXT_PUBLIC_SANITY_PROJECT_ID=xxx
